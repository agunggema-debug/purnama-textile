# ===== Backend Environment (copy to .env) =====
# On-premise: ganti dengan konfigurasi intranet pabrik
APP_NAME=Purnama Textile ERP
APP_ENV=production
SECRET_KEY=change-me-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL (default untuk development lokal via SQLite fallback; gunakan URL ini di docker)
# DATABASE_URL=postgresql+psycopg://purnama:purnama_secret@localhost:5432/purnama_erp
# DATABASE_URL=sqlite:///./purnama_erp.db
DATABASE_URL=postgresql+psycopg://purnama:purnama_secret@db:5432/purnama_erp

REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80

# Jalankan seed data master pada init (1 = ya)
SEED_ON_INIT=1
